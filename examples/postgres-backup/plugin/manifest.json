{
  "schemaVersion": 1,
  "id": "com.godesk.postgres-backup",
  "name": "PostgreSQL 备份",
  "version": "0.1.0",
  "minHostVersion": "0.3.0",
  "hostApi": { "min": 1, "max": 1 },
  "entry": { "lua": "lua/init.lua", "web": "web/index.html" },
  "config": {
    "备份目录": { "type": "string", "format": "writable-directory", "default": "" },
    "并行任务上限": { "type": "number", "format": "integer", "required": true, "min": 1, "max": 16, "default": 2 }
  }
}
